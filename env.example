# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=

# AWS (boto3 reads these names)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=
SQS_QUEUE_NAME=s3-orders-events

# Kafka (overridden to kafka:9092 inside Docker Compose)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders

# Airflow
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change_me
AIRFLOW_ADMIN_PASSWORD=admin

# Databricks job IDs (the connection "databricks_default" is created in the Airflow UI)
DATABRICKS_SILVER_JOB_ID=
DATABRICKS_GOLD_JOB_ID=
